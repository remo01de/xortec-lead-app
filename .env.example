# Perplexity API (Stufe 1 Search API + Stufe 2 Agent API, siehe docs/spezifikation.md §2, §6)
PERPLEXITY_API_KEY=

# Pfad zur SQLite-Datenbank
DATABASE_PATH=./data/app.db

# Deckel pro Recherche-Lauf (spec Q5, Q9)
RESEARCH_MAX_NEW_CANDIDATES=40
RESEARCH_MAX_COST_EUR=0.50

# Umkreis des harten Geofilters um den Gebietsmittelpunkt, in km (spec Q4)
RESEARCH_RADIUS_KM=40

# Nacht-Cron (spec Q13). Standardmaessig AUS -- jeder Lauf kostet echtes Geld.
# 2 Gebiete/Nacht sind ca. 0,40-0,50 EUR pro Nacht bzw. 12-15 EUR/Monat.
# Reihenfolge der Gebiete: data/plz-areas.json (von Hand umsortierbar).
CRON_ENABLED=false
CRON_SCHEDULE=0 2 * * *
CRON_TIMEZONE=Europe/Berlin
CRON_AREAS_PER_NIGHT=2

# Login (spec §7). Beide Werte erzeugt: npm run hash-password
# Das Klartextpasswort wird nirgends gespeichert.
AUTH_PASSWORD_HASH=
SESSION_SECRET=
SESSION_MAX_AGE_DAYS=30

# Server: PORT ist der Port IM Container, HOST_PORT der auf dem Rechner.
PORT=3000
HOST_PORT=9081

# Auf welcher Adresse der Container-Port veroeffentlicht wird.
# 127.0.0.1 = nur dieser Rechner (Standard, richtig fuer Produktion hinter Proxy).
# 0.0.0.0   = im ganzen WLAN erreichbar, z.B. fuer eine Demo auf dem Handy.
BIND_ADDR=127.0.0.1

# Pflicht-Kontaktangabe im User-Agent fuer Nominatim-Anfragen (OSMF-Nutzungsrichtlinie)
NOMINATIM_CONTACT_EMAIL=
