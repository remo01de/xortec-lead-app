{
  "name": "xortec-lead-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server/index.ts",
    "migrate": "tsx src/server/db/migrate.ts",
    "hash-password": "tsx scripts/hash-password.ts",
    "build:server": "tsc -p tsconfig.json && node scripts/copy-migrations.mjs",
    "build:client": "vite build",
    "build": "npm run build:server && npm run build:client",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json --noEmit"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/static": "^8.0.3",
    "dotenv": "^16.4.5",
    "fastify": "^5.1.0",
    "node-cron": "^4.6.0",
    "zod": "^3.23.8"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.4"
  }
}
